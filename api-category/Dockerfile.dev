# Dockerfile para desenvolvimento
FROM node:22-alpine

# Definir diretório de trabalho
WORKDIR /usr/src/app

# Instalar dependências globais necessárias
RUN npm install -g @nestjs/cli nodemon

# Instalar postgresql-client para o script de espera
RUN apk add --no-cache postgresql-client

# Copiar arquivos de dependências primeiro (para melhor cache)
COPY package*.json ./

# Instalar dependências
RUN npm install

# Copiar código fonte
COPY . .

# Tornar o script de espera executável
RUN chmod +x wait-for-db.sh

# Expor porta
EXPOSE 3000

# Comando para desenvolvimento com hot reload
CMD ["./wait-for-db.sh", "npm", "run", "start:dev"] 